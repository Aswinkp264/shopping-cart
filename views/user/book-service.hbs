<div class="service-bg">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <div class="service-card">

          <h3 class="text-center fw-bold mb-2 text-white">
            <i class="bi bi-tools me-2"></i>
            Book a Repair Service
          </h3>

          <p class="text-center text-white-50 mb-4">
            Fast and reliable mobile repair at your doorstep or our store
          </p>

          <form
            action="/book-service"
            method="POST"
            onsubmit="return validateBooking();"
          >

            <!-- CONTACT -->
            <div class="section-label">Contact Details</div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label text-light">Your Name</label>
                <input
                  type="text"
                  name="customerName"
                  id="customerName"
                  class="form-control service-input"
                  value="{{user.name}}"
                />
                <small class="text-danger" id="nameError"></small>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label text-light">Phone Number</label>
                <input
                  type="tel"
                  name="phone"
                  id="phone"
                  class="form-control service-input"
                  placeholder="10 digit number"
                  value="{{user.phone}}"
                />
                <small class="text-danger" id="phoneError"></small>
              </div>
            </div>

            <!-- DEVICE -->
            <div class="section-label">Device Details</div>

            <div class="row">

              <div class="col-md-6 mb-3">
                <label class="form-label text-light">Brand</label>

                <select
                  name="deviceBrand"
                  id="deviceBrand"
                  class="form-select service-input"
                >
                  <option value="">Select Brand</option>
                  <option>Samsung</option>
                  <option>Apple</option>
                  <option>OnePlus</option>
                  <option>Redmi</option>
                  <option>Realme</option>
                  <option>Oppo</option>
                  <option>Vivo</option>
                  <option>Nothing</option>
                  <option>Poco</option>
                  <option>iQOO</option>
                  <option>Other</option>
                </select>

                <small class="text-danger" id="brandError"></small>
              </div>

              <div class="col-md-6 mb-3">
                <label class="form-label text-light">Model</label>

                <input
                  type="text"
                  name="deviceModel"
                  id="deviceModel"
                  class="form-control service-input"
                  placeholder="e.g. Galaxy S23"
                />

                <small class="text-danger" id="modelError"></small>
              </div>

            </div>

            <!-- SERVICE -->
            <div class="mb-3">

              <label class="form-label text-light">Service Type</label>

              <select
                name="serviceType"
                id="serviceType"
                class="form-select service-input"
              >
                <option value="">Select Service</option>
                <option>Screen Replacement</option>
                <option>Battery Replacement</option>
                <option>Charging Port Repair</option>
                <option>Water Damage</option>
                <option>Software Issue</option>
                <option>Camera Repair</option>
                <option>Speaker / Mic Issue</option>
                <option>Other</option>
              </select>

              <small class="text-danger" id="serviceTypeError"></small>
            </div>

            <div class="mb-3">

              <label class="form-label text-light">
                Describe the Problem
              </label>

              <textarea
                name="problem"
                id="problem"
                class="form-control service-input"
                style="height:90px"
                placeholder="Tell us what's wrong with your device"
              ></textarea>

              <small class="text-danger" id="problemError"></small>

            </div>

            <!-- SCHEDULE -->
            <div class="section-label">Schedule</div>

            <div class="row">

              <div class="col-md-6 mb-3">

                <label class="form-label text-light">
                  Preferred Date
                </label>

                <input
                  type="date"
                  name="preferredDate"
                  id="preferredDate"
                  class="form-control service-input"
                />

                <small class="text-danger" id="dateError"></small>

              </div>

              <div class="col-md-6 mb-3">

                <label class="form-label text-light">
                  Time Slot
                </label>

                <select
                  name="timeSlot"
                  id="timeSlot"
                  class="form-select service-input"
                >
                  <option value="">Select Slot</option>
                  <option>9:00 AM - 11:00 AM</option>
                  <option>11:00 AM - 1:00 PM</option>
                  <option>1:00 PM - 3:00 PM</option>
                  <option>3:00 PM - 5:00 PM</option>
                  <option>5:00 PM - 7:00 PM</option>
                </select>

                <small class="text-danger" id="slotError"></small>

              </div>

            </div>

            <!-- VISIT TYPE -->
            <div class="mb-3">

              <label class="form-label text-light">Visit Type</label>

              <div class="d-flex gap-3 mt-1 flex-wrap">

                <label class="visit-option">

                  <input
                    type="radio"
                    name="visitType"
                    value="Walk-in"
                    checked
                    onchange="toggleAddress()"
                  />

                  <i class="bi bi-shop me-1"></i>
                  Walk-in to Store

                </label>

                <label class="visit-option">

                  <input
                    type="radio"
                    name="visitType"
                    value="Pickup"
                    onchange="toggleAddress()"
                  />

                  <i class="bi bi-truck me-1"></i>
                  Pickup from Home

                </label>

              </div>

            </div>

            <!-- ADDRESS -->
            <div class="pickup-section d-none" id="addressField">

              <div class="section-label">
                Pickup Address
              </div>

              <!-- CURRENT LOCATION -->
              <div class="mb-3">

                <button
                  type="button"
                  class="btn location-btn"
                  onclick="getCurrentLocation()"
                >
                  <i class="bi bi-geo-alt-fill me-2"></i>
                  Use Current Location
                </button>

                <small
                  id="locationStatus"
                  class="d-block mt-2 text-warning"
                ></small>

              </div>

              <!-- MAP -->
              <div class="mb-3">

                <iframe
                  id="locationMap"
                  width="100%"
                  height="260"
                  style="border:0; border-radius:16px;"
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                  src="https://maps.google.com/maps?q=Kerala&t=&z=13&ie=UTF8&iwloc=&output=embed"
                ></iframe>

              </div>

              <!-- HIDDEN -->
              <input type="hidden" name="latitude" id="latitude" />
              <input type="hidden" name="longitude" id="longitude" />

              <!-- ADDRESS FORM -->
              <div class="row">

                <div class="col-md-6 mb-3">

                  <label class="form-label text-light">
                    House / Flat / Building
                  </label>

                  <input
                    type="text"
                    name="house"
                    id="house"
                    class="form-control service-input"
                    placeholder="House No / Flat / Building"
                  />

                </div>

                <div class="col-md-6 mb-3">

                  <label class="form-label text-light">
                    Landmark
                  </label>

                  <input
                    type="text"
                    name="landmark"
                    id="landmark"
                    class="form-control service-input"
                    placeholder="Nearby landmark"
                  />

                </div>

              </div>

              <div class="mb-3">

                <label class="form-label text-light">
                  Street Address
                </label>

                <textarea
                  name="address"
                  id="address"
                  class="form-control service-input"
                  style="height:80px"
                  placeholder="Street / Area / Locality"
                ></textarea>

              </div>

              <div class="row">

                <div class="col-md-4 mb-3">

                  <label class="form-label text-light">District</label>

                  <input
                    type="text"
                    name="district"
                    id="district"
                    class="form-control service-input"
                    placeholder="District"
                  />

                </div>

                <div class="col-md-4 mb-3">

                  <label class="form-label text-light">State</label>

                  <input
                    type="text"
                    name="state"
                    id="state"
                    class="form-control service-input"
                    placeholder="State"
                  />

                </div>

                <div class="col-md-4 mb-3">

                  <label class="form-label text-light">PIN Code</label>

                  <input
                    type="text"
                    name="pincode"
                    id="pincode"
                    class="form-control service-input"
                    placeholder="PIN Code"
                  />

                </div>

              </div>

              <!-- ADDRESS TYPE -->
              <div class="mb-3">

                <label class="form-label text-light">
                  Address Type
                </label>

                <div class="d-flex gap-3 flex-wrap">

                  <label class="visit-option">

                    <input
                      type="radio"
                      name="addressType"
                      value="Home"
                      checked
                    />

                    <i class="bi bi-house-door me-1"></i>
                    Home

                  </label>

                  <label class="visit-option">

                    <input
                      type="radio"
                      name="addressType"
                      value="Company"
                    />

                    <i class="bi bi-building me-1"></i>
                    Company

                  </label>

                </div>

              </div>

              <small class="text-danger" id="addressError"></small>

            </div>

            <!-- BUTTON -->
            <div class="d-grid mt-4">

              <button class="btn service-btn">

                <i class="bi bi-calendar-check me-2"></i>
                Confirm Booking

              </button>

            </div>

          </form>

        </div>

      </div>
    </div>
  </div>
</div>

<style>

  .service-bg{
    min-height:100vh;
    background:linear-gradient(135deg,#1e1e2f,#2b2b45);
    display:flex;
    align-items:center;
  }

  .service-card{
    backdrop-filter:blur(12px);
    background:rgba(255,255,255,0.08);
    padding:40px;
    border-radius:20px;
    box-shadow:0 15px 40px rgba(0,0,0,0.4);
    border:1px solid rgba(255,255,255,0.1);
  }

  .service-input{
    background:rgba(255,255,255,0.1);
    border:1px solid rgba(255,255,255,0.2);
    color:white;
    border-radius:12px;
    padding:12px;
  }

  .service-input::placeholder{
    color:#ddd;
  }

  .service-input:focus{
    background:rgba(255,255,255,0.15);
    border-color:#ffc107;
    box-shadow:0 0 12px rgba(255,193,7,0.4);
    color:white;
  }

  .service-input option{
    background:#2b2b45;
    color:white;
  }

  .section-label{
    color:#ffc107;
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:1px;
    margin-bottom:12px;
    margin-top:8px;
    padding-bottom:6px;
    border-bottom:1px solid rgba(255,193,7,0.3);
  }

  .visit-option{
    background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.15);
    border-radius:12px;
    padding:10px 16px;
    color:white;
    font-size:14px;
    cursor:pointer;
    display:flex;
    align-items:center;
    transition:all 0.2s ease;
  }

  .visit-option:hover{
    border-color:#ffc107;
  }

  .visit-option input{
    accent-color:#ffc107;
    margin-right:8px;
  }

  .pickup-section{
    background:rgba(255,255,255,0.04);
    padding:20px;
    border-radius:16px;
    border:1px solid rgba(255,255,255,0.08);
  }

  .location-btn{
    background:linear-gradient(135deg,#00c6ff,#0072ff);
    border:none;
    color:white;
    padding:12px 18px;
    border-radius:12px;
    font-weight:600;
  }

  .location-btn:hover{
    opacity:0.9;
    color:white;
  }

  .service-btn{
    background:linear-gradient(135deg,#ff9800,#ff5722);
    border:none;
    padding:13px;
    border-radius:30px;
    font-weight:bold;
    color:white;
    transition:all 0.3s ease;
  }

  .service-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(0,0,0,0.4);
    color:white;
  }

</style>

<script>

  function toggleAddress() {

    const pickup =
      document.querySelector('input[name="visitType"]:checked').value === 'Pickup';

    document
      .getElementById('addressField')
      .classList.toggle('d-none', !pickup);
  }

  async function getCurrentLocation() {

    const status = document.getElementById('locationStatus');

    if (!navigator.geolocation) {
      status.innerText = 'Geolocation not supported';
      return;
    }

    status.innerText = 'Fetching precise location...';

    navigator.geolocation.getCurrentPosition(

      async (position) => {

        const lat = position.coords.latitude;
        const lng = position.coords.longitude;

        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;

        // MAP
        document.getElementById('locationMap').src =
          `https://maps.google.com/maps?q=${lat},${lng}&z=17&output=embed`;

        try {

          const response = await fetch(
            `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`
          );

          const data = await response.json();

          if (data.address) {

            const addr = data.address;

            document.getElementById('address').value =
              [
                addr.road,
                addr.suburb,
                addr.village,
                addr.town,
                addr.city
              ]
              .filter(Boolean)
              .join(', ');

            document.getElementById('district').value =
              addr.state_district || '';

            document.getElementById('state').value =
              addr.state || '';

            document.getElementById('pincode').value =
              addr.postcode || '';

          }

          status.innerText = 'Location selected successfully';

        } catch (err) {

          console.log(err);

          status.innerText =
            'Location fetched, but address not found';

        }

      },

      (error) => {

        console.log(error);

        status.innerText =
          'Please allow location permission';

      },

      {
        enableHighAccuracy: true,
        timeout: 15000,
        maximumAge: 0
      }

    );
  }

  function validateBooking() {

    let ok = true;

    [
      'nameError',
      'phoneError',
      'brandError',
      'modelError',
      'serviceTypeError',
      'problemError',
      'dateError',
      'slotError',
      'addressError'
    ].forEach(id => {

      const el = document.getElementById(id);

      if (el) el.innerText = '';

    });

    if (!customerName.value.trim()) {
      nameError.innerText = 'Required';
      ok = false;
    }

    if (!/^[0-9]{10}$/.test(phone.value.trim())) {
      phoneError.innerText = 'Enter valid 10 digit number';
      ok = false;
    }

    if (!deviceBrand.value) {
      brandError.innerText = 'Required';
      ok = false;
    }

    if (!deviceModel.value.trim()) {
      modelError.innerText = 'Required';
      ok = false;
    }

    if (!serviceType.value) {
      serviceTypeError.innerText = 'Required';
      ok = false;
    }

    if (!problem.value.trim()) {
      problemError.innerText = 'Required';
      ok = false;
    }

    if (!preferredDate.value) {
      dateError.innerText = 'Required';
      ok = false;
    }

    if (!timeSlot.value) {
      slotError.innerText = 'Required';
      ok = false;
    }

    const isPickup =
      document.querySelector('input[name="visitType"]:checked').value === 'Pickup';

    if (isPickup) {

      if (!address.value.trim()) {
        addressError.innerText = 'Address required';
        ok = false;
      }

      if (!pincode.value.trim()) {
        addressError.innerText = 'PIN code required';
        ok = false;
      }

    }

    return ok;
  }

  // PREVENT PAST DATE
  document.getElementById('preferredDate').min =
    new Date().toISOString().split('T')[0];

</script>
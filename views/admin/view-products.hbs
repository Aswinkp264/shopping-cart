<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Products</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
      rel="stylesheet"
    />

    <style>
      body {
        background-color: #f4f6f9;
      }

      .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
      }

      .table-hover tbody tr:hover {
        background-color: #f8f9fa;
      }

      .card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>

    <section class="py-4">
      <div class="container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="fw-bold">📦 All Products</h4>
          <a href="/admin/add-products" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Product
          </a>
        </div>

        <!-- Card -->
        <div class="card shadow-sm border-0 rounded-4">
          <div class="card-body p-0">

            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                  <tr>
                    <th>#</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th class="text-center" style="width: 140px;">Actions</th>
                  </tr>
                </thead>

                <tbody>
                  {{#each products}}
                    <tr>

                      <td>{{inc @index}}</td>

                      <td>
                        <img
                          src="/product-images/{{this._id}}.jpg"
                          class="product-img"
                          alt="product"
                        />
                      </td>

                      <td class="fw-semibold">{{this.name}}</td>

                      <td>
                        {{#if this.discount}}
                          <div>
                            <span class="fw-bold text-success">
                              ₹{{this.finalPrice}}
                            </span>
                            <br />
                            <small
                              class="text-decoration-line-through text-muted"
                            >
                              ₹{{this.price}}
                            </small>
                            <span class="badge bg-danger">
                              {{this.discount}}% OFF
                            </span>
                          </div>
                        {{else}}
                          <span class="fw-bold text-success">
                            ₹{{this.price}}
                          </span>
                        {{/if}}
                      </td>

                      <td>
                        <span class="badge bg-secondary">
                          {{this.category}}
                        </span>
                      </td>

                      <td class="text-muted small">
                        {{this.description}}
                      </td>
                      <!-- ACTION BUTTONS -->
                      <td class="text-center" style="white-space: nowrap;">

                        <a
                          href="/admin/edit-product/{{this._id}}"
                          class="btn btn-sm btn-warning me-1"
                          title="Edit"
                        >
                          <i class="bi bi-pencil"></i>
                        </a>

                        <a
                          href="/admin/delete-product/{{this._id}}"
                          class="btn btn-sm btn-danger"
                          title="Delete"
                          onclick="return confirm('Delete this product?')"
                        >
                          <i class="bi bi-trash"></i>
                        </a>

                      </td>

                    </tr>
                  {{/each}}
                </tbody>

              </table>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    ></script>

  </body>
</html>
```html
<section class="py-4" style="background: #f0f2f5; min-height: 100vh;">

  <div class="container">

    <!-- PAGE HEADER -->
    <div class="d-flex align-items-center mb-4">

      <div class="header-icon me-3">
        <i class="bi bi-speedometer2 fs-4 text-white"></i>
      </div>

      <div>
        <h3 class="fw-bold mb-0">
          Dashboard
        </h3>

        <small class="text-muted">
          Welcome back, Admin!
        </small>
      </div>

    </div>

    <!-- STATS CARDS -->
    <div class="row g-3 mb-4">

      <!-- USERS -->
      <div class="col-md-3">

        <div class="stat-card">

          <div
            class="stat-icon"
            style="
              background:
              linear-gradient(
                135deg,
                #667eea,
                #764ba2
              );
            "
          >
            <i class="bi bi-people text-white fs-4"></i>
          </div>

          <div class="mt-3">
            <h2 class="fw-bold mb-0">
              {{stats.totalUsers}}
            </h2>

            <small class="text-muted">
              Total Users
            </small>
          </div>

          <a
            href="/admin/users"
            class="stat-link"
          >
            View all →
          </a>

        </div>

      </div>

      <!-- PRODUCTS -->
      <div class="col-md-3">

        <div class="stat-card">

          <div
            class="stat-icon"
            style="
              background:
              linear-gradient(
                135deg,
                #f093fb,
                #f5576c
              );
            "
          >
            <i class="bi bi-box-seam text-white fs-4"></i>
          </div>

          <div class="mt-3">
            <h2 class="fw-bold mb-0">
              {{stats.totalProducts}}
            </h2>

            <small class="text-muted">
              Total Products
            </small>
          </div>

          <a
            href="/admin/products"
            class="stat-link"
          >
            View all →
          </a>

        </div>

      </div>

      <!-- ORDERS -->
      <div class="col-md-3">

        <div class="stat-card">

          <div
            class="stat-icon"
            style="
              background:
              linear-gradient(
                135deg,
                #4facfe,
                #00f2fe
              );
            "
          >
            <i class="bi bi-receipt text-white fs-4"></i>
          </div>

          <div class="mt-3">
            <h2 class="fw-bold mb-0">
              {{stats.totalOrders}}
            </h2>

            <small class="text-muted">
              Total Orders
            </small>
          </div>

          <a
            href="/admin/orders"
            class="stat-link"
          >
            View all →
          </a>

        </div>

      </div>

      <!-- REVENUE -->
      <div class="col-md-3">

        <div class="stat-card">

          <div
            class="stat-icon"
            style="
              background:
              linear-gradient(
                135deg,
                #43e97b,
                #38f9d7
              );
            "
          >
            <i class="bi bi-currency-rupee text-white fs-4"></i>
          </div>

          <div class="mt-3">
            <h2 class="fw-bold mb-0">
              ₹ {{stats.totalRevenue}}
            </h2>

            <small class="text-muted">
              Total Revenue
            </small>
          </div>

        </div>

      </div>

      <!-- SERVICE BOOKINGS -->
      <div class="col-md-3">

        <div class="stat-card">

          <div
            class="stat-icon"
            style="
              background:
              linear-gradient(
                135deg,
                #ff9966,
                #ff5e62
              );
            "
          >

            <i class="bi bi-tools text-white fs-4"></i>

          </div>

          <div class="mt-3">

            <h2 class="fw-bold mb-0">
              {{stats.totalServiceBookings}}
            </h2>

            <small class="text-muted">
              Service Bookings
            </small>

          </div>

          <a
            href="/admin/service-bookings"
            class="stat-link"
          >

            View all →

          </a>

        </div>

      </div>

    </div>

    <!-- ORDER STATUS -->
    <div class="row g-3 mb-4">

      <!-- PENDING -->
      <div class="col-md-3">

        <div class="status-card placed">

          <i class="bi bi-clock fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.pendingOrders}}
          </h4>

          <small>
            Pending Orders
          </small>

        </div>

      </div>

      <!-- SHIPPED -->
      <div class="col-md-3">

        <div class="status-card shipped">

          <i class="bi bi-truck fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.shippedOrders}}
          </h4>

          <small>
            Shipped Orders
          </small>

        </div>

      </div>

      <!-- DELIVERED -->
      <div class="col-md-3">

        <div class="status-card delivered">

          <i class="bi bi-check-circle fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.deliveredOrders}}
          </h4>

          <small>
            Delivered Orders
          </small>

        </div>

      </div>

      <!-- CANCELLED -->
      <div class="col-md-3">

        <div class="status-card cancelled">

          <i class="bi bi-x-circle fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.cancelledOrders}}
          </h4>

          <small>
            Cancelled Orders
          </small>

        </div>

      </div>

    </div>

    <!-- SERVICE STATUS -->
    <div class="row g-3 mb-4">

      <!-- PENDING -->
      <div class="col-md-4">

        <div class="status-card placed">

          <i class="bi bi-hourglass-split fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.pendingServices}}
          </h4>

          <small>
            Pending Services
          </small>

        </div>

      </div>

      <!-- IN PROGRESS -->
      <div class="col-md-4">

        <div class="status-card shipped">

          <i class="bi bi-tools fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.inProgressServices}}
          </h4>

          <small>
            In Progress
          </small>

        </div>

      </div>

      <!-- COMPLETED -->
      <div class="col-md-4">

        <div class="status-card delivered">

          <i class="bi bi-check2-circle fs-4"></i>

          <h4 class="fw-bold mt-2 mb-0">
            {{stats.completedServices}}
          </h4>

          <small>
            Completed Services
          </small>

        </div>

      </div>

    </div>

    <!-- RECENT ORDERS -->
    <div
      class="card border-0 shadow-sm"
      style="
        border-radius: 20px;
        overflow: hidden;
      "
    >

      <div
        class="card-header d-flex justify-content-between align-items-center py-3 px-4"
        style="
          background:
          linear-gradient(
            135deg,
            #1e1e2f,
            #2b2b45
          );

          border: none;
        "
      >

        <h6 class="fw-bold text-white mb-0">

          <i class="bi bi-clock-history me-2"></i>

          Recent Orders

        </h6>

        <a
          href="/admin/orders"
          class="btn btn-sm btn-outline-light"
          style="border-radius: 8px;"
        >
          View All
        </a>

      </div>

      <div class="table-responsive">

        <table class="table table-hover mb-0">

          <thead style="background: #f8f9fa;">

            <tr>

              <th class="py-3 px-4">
                Order ID
              </th>

              <th class="py-3">
                Customer
              </th>

              <th class="py-3">
                Amount
              </th>

              <th class="py-3">
                Payment
              </th>

              <th class="py-3">
                Status
              </th>

            </tr>

          </thead>

          <tbody>

            {{#each stats.recentOrders}}

              <tr>

                <td class="px-4 py-3">
                  <small class="text-muted">
                    {{this._id}}
                  </small>
                </td>

                <td class="py-3 fw-semibold">
                  {{this.user.name}}
                </td>

                <td class="py-3 text-success fw-bold">
                  ₹ {{this.totalAmount}}
                </td>

                <td class="py-3">
                  {{this.paymentMethod}}
                </td>

                <td class="py-3">

                  {{#if (eq this.status "Placed")}}

                    <span class="badge-sm placed">
                      Placed
                    </span>

                  {{else if (eq this.status "Shipped")}}

                    <span class="badge-sm shipped">
                      Shipped
                    </span>

                  {{else if (eq this.status "Delivered")}}

                    <span class="badge-sm delivered">
                      Delivered
                    </span>

                  {{else if (eq this.status "Cancelled")}}

                    <span class="badge-sm cancelled">
                      Cancelled
                    </span>

                  {{/if}}

                </td>

              </tr>

            {{/each}}

          </tbody>

        </table>

      </div>

    </div>

  </div>

</section>

<style>

  .header-icon {

    width: 48px;
    height: 48px;

    background:
      linear-gradient(
        135deg,
        #1e1e2f,
        #2b2b45
      );

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-card {

    background: white;

    border-radius: 20px;

    padding: 24px;

    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.06);

    transition: transform 0.2s ease;

    position: relative;
  }

  .stat-card:hover {

    transform: translateY(-4px);

    box-shadow:
      0 8px 30px rgba(0, 0, 0, 0.1);
  }

  .stat-icon {

    width: 52px;
    height: 52px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-link {

    display: block;

    margin-top: 10px;

    font-size: 13px;

    color: #888;

    text-decoration: none;
  }

  .stat-link:hover {

    color: #333;
  }

  .status-card {

    background: white;

    border-radius: 16px;

    padding: 20px;

    text-align: center;

    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.06);

    border-left: 4px solid;
  }

  .status-card.placed {

    border-color: #0d6efd;

    color: #0d6efd;
  }

  .status-card.shipped {

    border-color: #e6a800;

    color: #e6a800;
  }

  .status-card.delivered {

    border-color: #198754;

    color: #198754;
  }

  .status-card.cancelled {

    border-color: #dc3545;

    color: #dc3545;
  }

  .badge-sm {

    padding: 4px 10px;

    border-radius: 20px;

    font-size: 12px;

    font-weight: 600;
  }

  .badge-sm.placed {

    background:
      rgba(13, 110, 253, 0.15);

    color: #0d6efd;
  }

  .badge-sm.shipped {

    background:
      rgba(255, 193, 7, 0.15);

    color: #e6a800;
  }

  .badge-sm.delivered {

    background:
      rgba(25, 135, 84, 0.15);

    color: #198754;
  }

  .badge-sm.cancelled {

    background:
      rgba(220, 53, 69, 0.15);

    color: #dc3545;
  }

  table thead th {

    font-weight: 600;

    font-size: 13px;

    color: #666;

    border: none;
  }

  table tbody tr {

    border-bottom: 1px solid #f0f0f0;
  }

  table tbody tr:hover {

    background: #f8f9fa;
  }

</style>
```
